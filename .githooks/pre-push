#!/bin/sh
# Confidentiality guard before each push (see DATA_POLICY.md). Never bypass with --no-verify.
. "$(git rev-parse --show-toplevel)/.githooks/_python.sh"
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  branch=${remote_ref#refs/heads/}
  if [ "$branch" = "main" ]; then
    echo "✗ Direct pushes to main are not allowed: push a branch and open a pull request." >&2
    status=1
    continue
  fi
  "$PY" tools/guard.py branch "$branch" || status=1
  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "$zero")
  else
    base=$remote_sha
  fi
  "$PY" tools/guard.py range "$base" "$local_sha" || status=1
done
exit $status
